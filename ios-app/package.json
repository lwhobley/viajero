  "private": true,
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "eas:configure": "npx eas-cli@latest init",
    "eas:preview": "npx eas-cli@latest build --platform ios --profile preview",
